+	"github.com/tidwall/sjson"
+)
+
+func TestOpenAICompatCompactionRoundTrip(t *testing.T) {
+	for _, stream := range []bool{false, true} {
+		t.Run(fmt.Sprintf("stream=%t", stream), func(t *testing.T) {
+			var requests [][]byte
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				body, _ := io.ReadAll(r.Body)
+				requests = append(requests, body)
+				if r.URL.Path != "/v1/chat/completions" || r.Header.Get("Authorization") != "Bearer test-key" {
+					t.Errorf("unexpected upstream route or credential: %s", r.URL.Path)
+				}
+				w.Header().Set("Content-Type", "application/json")
+				_, _ = io.WriteString(w, `{"id":"summary","object":"chat.completion","choices":[{"message":{"role":"assistant","content":"The project codename is cobalt. Rename foo to bar; no files changed."},"finish_reason":"stop"}],"usage":{"prompt_tokens":100,"completion_tokens":20,"total_tokens":120}}`)
+			}))
+			defer server.Close()
+			executor := NewOpenAICompatExecutor("test", &config.Config{})
+			auth := &cliproxyauth.Auth{Attributes: map[string]string{"base_url": server.URL + "/v1", "api_key": "test-key"}}
+			payload := []byte(`{"model":"local-model","input":[{"type":"additional_tools","tools":[{"type":"function","name":"desktop_shell","parameters":{"type":"object"}}]},{"type":"message","role":"user","content":"The project codename is cobalt. Rename foo to bar."},{"type":"message","role":"assistant","content":"No files changed."},{"type":"compaction_trigger"}],"tools":[{"type":"function","name":"shell","parameters":{"type":"object"}}],"tool_choice":"auto"}`)
+			opts := cliproxyexecutor.Options{SourceFormat: sdktranslator.FormatOpenAIResponse, ResponseFormat: sdktranslator.FormatOpenAIResponse, Stream: stream, OriginalRequest: payload}
+			req := cliproxyexecutor.Request{Model: "local-model", Payload: payload}
+			var compacted []byte
+			if stream {
+				result, err := executor.ExecuteStream(context.Background(), auth, req, opts)
+				if err != nil {
+					t.Fatal(err)
+				}
+				var outputItems, completed int
+				for chunk := range result.Chunks {
+					if chunk.Err != nil {
+						t.Fatal(chunk.Err)
+					}
+					for line := range strings.SplitSeq(string(chunk.Payload), "\n") {
+						if !strings.HasPrefix(line, "data: ") {
+							continue
+						}
+						data := []byte(strings.TrimPrefix(line, "data: "))
+						switch gjson.GetBytes(data, "type").String() {
+						case "response.output_item.done":
+							outputItems++
+							if gjson.GetBytes(data, "item.type").String() != "compaction" {
+								t.Fatalf("unexpected output item: %s", data)
+							}
+						case "response.completed":
+							completed++
+							compacted = []byte(gjson.GetBytes(data, "response").Raw)
+						}
+					}
+				}
+				if outputItems != 1 || completed != 1 {
+					t.Fatalf("items=%d, completed=%d; Codex needs exactly one of each", outputItems, completed)
+				}
+			} else {
+				result, err := executor.Execute(context.Background(), auth, req, opts)
+				if err != nil {
+					t.Fatal(err)
+				}
+				compacted = result.Payload
+			}
+			if len(requests) != 1 || !strings.Contains(string(requests[0]), "cobalt") || !strings.Contains(string(requests[0]), "summary") {
+				t.Fatalf("summary request lost the conversation: %q", requests)
+			}
+			if gjson.GetBytes(requests[0], "tools").Exists() || gjson.GetBytes(requests[0], "stream").Bool() || strings.Contains(string(requests[0]), "compaction_trigger") {
+				t.Fatalf("summary must be a non-stream chat request without tools or triggers: %s", requests[0])
+			}
+			if gjson.GetBytes(compacted, "output.0.type").String() != "compaction" || gjson.GetBytes(compacted, "output.0.encrypted_content").String() == "" || gjson.GetBytes(compacted, "usage.input_tokens").Int() != 100 {
+				t.Fatalf("invalid compaction response: %s", compacted)
+			}
+
+			// Replay through both payload copies, then compact the restored context again.
+			replay, _ := sjson.SetRawBytes([]byte(`{"model":"local-model"}`), "input", []byte(gjson.GetBytes(compacted, "output").Raw))
+			req.Payload, opts.OriginalRequest = replay, replay
+			opts.Stream = false
+			if _, err := executor.Execute(context.Background(), auth, req, opts); err != nil {
+				t.Fatal(err)
+			}
+			replay, _ = sjson.SetRawBytes(replay, "input.-1", []byte(`{"type":"compaction_trigger"}`))
+			req.Payload, opts.OriginalRequest = replay, replay
+			if _, err := executor.Execute(context.Background(), auth, req, opts); err != nil {
+				t.Fatal(err)
+			}
+			for _, body := range requests[1:] {
+				if !strings.Contains(string(body), "The project codename is cobalt") || strings.Contains(string(body), "encrypted_content") {
+					t.Fatalf("compacted context was not restored before translation: %s", body)
+				}
+			}
+		})
+	}
+}
+
+func TestOpenAICompatCompactionRejectsInvalidSummary(t *testing.T) {
+	for _, response := range []string{
+		`{"choices":[{"message":{"content":""},"finish_reason":"stop"}]}`,
+		`{"choices":[{"message":{"content":"   "},"finish_reason":"stop"}]}`,
+		`{"choices":[{"message":{"content":"unfinished summary"},"finish_reason":"length"}]}`,
+		`{"choices":[{"message":{"content":"partial summary"},"finish_reason":"content_filter"}]}`,
+		`{"choices":[{"message":{"content":"unconfirmed summary"}}]}`,
+		`{"choices":[{"message":{"content":"Inspect files first","tool_calls":[{"id":"call_1","type":"function","function":{"name":"shell","arguments":"{}"}}]},"finish_reason":"tool_calls"}]}`,
+		`{"choices":[{"message":{"content":"Inspect files first","tool_calls":[{"id":"call_1","type":"function","function":{"name":"shell","arguments":"{}"}}]},"finish_reason":"stop"}]}`,
+		`{"choices":[{"message":{"content":"Inspect files first","function_call":{"name":"shell","arguments":"{}"}},"finish_reason":"stop"}]}`,
+		`{"choices":[{"message":{"content":"Cannot summarize","refusal":"Cannot comply"},"finish_reason":"stop"}]}`,
+	} {
+		server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			_, _ = io.WriteString(w, response)
+		}))
+		executor := NewOpenAICompatExecutor("test", &config.Config{})
+		auth := &cliproxyauth.Auth{Attributes: map[string]string{"base_url": server.URL}}
+		_, err := executor.ExecuteStream(context.Background(), auth,
+			cliproxyexecutor.Request{Model: "local-model", Payload: []byte(`{"input":[{"type":"compaction_trigger"}]}`)},
+			cliproxyexecutor.Options{SourceFormat: sdktranslator.FormatOpenAIResponse, Stream: true})
+		server.Close()
+		if err == nil {
+			t.Fatalf("accepted unusable summary: %s", response)
+		}
+	}
+}
+
+func TestOpenAICompatCompactionRejectsUnknownCapsule(t *testing.T) {
+	executor := NewOpenAICompatExecutor("test", &config.Config{})
+	_, err := executor.ExecuteStream(context.Background(), nil,
+		cliproxyexecutor.Request{Model: "local-model", Payload: []byte(`{"input":[{"type":"compaction","encrypted_content":"unknown-format"}]}`)},
+		cliproxyexecutor.Options{SourceFormat: sdktranslator.FormatOpenAIResponse, Stream: true})
+	if status, ok := err.(interface{ StatusCode() int }); !ok || status.StatusCode() != http.StatusBadRequest {
+		t.Fatalf("expected explicit rejection of unreadable context, got %v", err)
+	}
+}
