+package executor
+
+import (
+	"context"
+	"fmt"
+	"net/http"
+	"strings"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/runtime/executor/helps"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/thinking"
+	cliproxyauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+	sdktranslator "github.com/router-for-me/CLIProxyAPI/v8/sdk/translator"
+	"github.com/tidwall/gjson"
+)
+
+// Antigravity's compaction helpers operate on Responses JSON, so its existing
+// summary format can also be used for Chat Completions backends.
+func expandOpenAICompatCompaction(req *cliproxyexecutor.Request, opts *cliproxyexecutor.Options) error {
+	for _, payload := range []*[]byte{&req.Payload, &opts.OriginalRequest} {
+		if !helps.HasResponsesCompactionItem(*payload) {
+			continue
+		}
+		expanded, err := helps.ExpandAntigravityCompactionCapsules(*payload)
+		if err != nil {
+			return statusErr{code: http.StatusBadRequest, msg: err.Error()}
+		}
+		*payload = expanded
+	}
+	return nil
+}
+
+func (e *OpenAICompatExecutor) executeCompaction(ctx context.Context, auth *cliproxyauth.Auth, req cliproxyexecutor.Request, opts cliproxyexecutor.Options) (cliproxyexecutor.Response, error) {
+	baseModel := thinking.ParseSuffix(req.Model).ModelName
+	payload := req.Payload
+	if len(payload) == 0 {
+		payload = opts.OriginalRequest
+	}
+	req.Payload = helps.PrepareAntigravityCompactionSummaryPayload(payload, baseModel)
+	opts.Alt = ""
+	opts.Stream = false
+	opts.OriginalRequest = nil
+	opts.SourceFormat = sdktranslator.FormatOpenAIResponse
+	opts.ResponseFormat = sdktranslator.FormatOpenAI
+	response, err := e.Execute(ctx, auth, req, opts)
+	if err != nil {
+		return cliproxyexecutor.Response{}, err
+	}
+	// A checkpoint replaces history, so accept only a finished text summary.
+	choice := gjson.GetBytes(response.Payload, "choices.0")
+	message := choice.Get("message")
+	if choice.Get("finish_reason").String() != "stop" ||
+		len(message.Get("tool_calls").Array()) != 0 ||
+		message.Get("function_call").IsObject() ||
+		strings.TrimSpace(message.Get("refusal").String()) != "" {
+		return cliproxyexecutor.Response{}, fmt.Errorf("compaction did not finish a text summary")
+	}
+	summary, err := helps.ExtractAntigravitySummaryText(response.Payload)
+	if err != nil {
+		return cliproxyexecutor.Response{}, fmt.Errorf("extract compaction summary: %w", err)
+	}
+	if strings.TrimSpace(summary) == "" {
+		return cliproxyexecutor.Response{}, fmt.Errorf("compaction summary was empty")
+	}
+	capsule, err := helps.SealAntigravityCompaction(summary, baseModel)
+	if err != nil {
+		return cliproxyexecutor.Response{}, err
+	}
+	usage := helps.ParseOpenAIUsage(response.Payload)
+	response.Payload = helps.BuildAntigravityCompactionResponse(baseModel, capsule, int(usage.InputTokens), int(usage.OutputTokens), int(usage.TotalTokens))
+	response.Headers = response.Headers.Clone()
+	if response.Headers == nil {
+		response.Headers = make(http.Header)
+	}
+	response.Headers.Del("Content-Length")
+	response.Headers.Del("Content-Encoding")
+	response.Headers.Set("Content-Type", "application/json")
+	return response, nil
+}
+
+func (e *OpenAICompatExecutor) executeCompactionStream(ctx context.Context, auth *cliproxyauth.Auth, req cliproxyexecutor.Request, opts cliproxyexecutor.Options) (*cliproxyexecutor.StreamResult, error) {
+	response, err := e.executeCompaction(ctx, auth, req, opts)
+	if err != nil {
+		return nil, err
+	}
+	baseModel := thinking.ParseSuffix(req.Model).ModelName
+	capsule := gjson.GetBytes(response.Payload, "output.0.encrypted_content").String()
+	usage := helps.ParseOpenAIUsage(response.Payload)
+	frames := helps.BuildAntigravityCompactionStreamChunks(baseModel, capsule, int(usage.InputTokens), int(usage.OutputTokens), int(usage.TotalTokens))
+	chunks := make(chan cliproxyexecutor.StreamChunk, len(frames))
+	for _, frame := range frames {
+		chunks <- cliproxyexecutor.StreamChunk{Payload: frame}
+	}
+	close(chunks)
+	response.Headers.Set("Content-Type", "text/event-stream")
+	return &cliproxyexecutor.StreamResult{Headers: response.Headers, Chunks: chunks}, nil
+}
