+package test
+
+import (
+	"context"
+	"fmt"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/gin-gonic/gin"
+	"github.com/gorilla/websocket"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/registry"
+	runtimeexecutor "github.com/router-for-me/CLIProxyAPI/v8/internal/runtime/executor"
+	_ "github.com/router-for-me/CLIProxyAPI/v8/internal/translator"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/util"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/api/handlers"
+	openaihandlers "github.com/router-for-me/CLIProxyAPI/v8/sdk/api/handlers/openai"
+	cliproxyauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+	"github.com/tidwall/gjson"
+)
+
+func TestOpenAICompatCompactionWebsocket(t *testing.T) {
+	const model = "compaction-websocket-model"
+	requests := make(chan string, 3)
+	upstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		body, errRead := io.ReadAll(r.Body)
+		if errRead != nil {
+			t.Error(errRead)
+			return
+		}
+		requests <- string(body)
+		if r.URL.Path != "/v1/chat/completions" {
+			t.Errorf("unexpected upstream path: %s", r.URL.Path)
+		}
+		if !gjson.GetBytes(body, "stream").Bool() {
+			w.Header().Set("Content-Type", "application/json")
+			_, _ = io.WriteString(w, `{"id":"summary","object":"chat.completion","choices":[{"message":{"role":"assistant","content":"CHECKPOINT_SUMMARY"},"finish_reason":"stop"}]}`)
+			return
+		}
+		w.Header().Set("Content-Type", "text/event-stream")
+		delta, finish := `{"role":"assistant","content":"INITIAL_ASSISTANT"}`, "stop"
+		if gjson.GetBytes(body, "tools").Exists() {
+			delta, finish = `{"role":"assistant","tool_calls":[{"index":0,"id":"call_shell","type":"function","function":{"name":"shell","arguments":"{}"}}]}`, "tool_calls"
+		}
+		_, _ = fmt.Fprintf(w, "data: {\"id\":\"chatcmpl_mock\",\"object\":\"chat.completion.chunk\",\"model\":%q,\"choices\":[{\"index\":0,\"delta\":%s,\"finish_reason\":null}]}\n\n", model, delta)
+		_, _ = fmt.Fprintf(w, "data: {\"id\":\"chatcmpl_mock\",\"object\":\"chat.completion.chunk\",\"model\":%q,\"choices\":[{\"index\":0,\"delta\":{},\"finish_reason\":%q}]}\n\ndata: [DONE]\n\n", model, finish)
+	}))
+	defer upstream.Close()
+	cfg := &config.Config{OpenAICompatibility: []config.OpenAICompatibility{{
+		Name: "compaction-websocket", BaseURL: upstream.URL + "/v1",
+		Models: []config.OpenAICompatibilityModel{{Name: model, Alias: model}},
+	}}}
+	provider := util.OpenAICompatibleProviderKey("compaction-websocket")
+	manager := cliproxyauth.NewManager(nil, &cliproxyauth.RoundRobinSelector{}, nil)
+	manager.SetConfig(cfg)
+	manager.SetRetryConfig(0, 0, 0)
+	manager.RegisterExecutor(runtimeexecutor.NewOpenAICompatExecutor(provider, cfg))
+	registry.GetGlobalRegistry().RegisterClient(t.Name(), provider, []*registry.ModelInfo{{ID: model}})
+	defer registry.GetGlobalRegistry().UnregisterClient(t.Name())
+	_, errRegister := manager.Register(context.Background(), &cliproxyauth.Auth{
+		ID: t.Name(), Provider: provider, Status: cliproxyauth.StatusActive,
+		Attributes: map[string]string{"base_url": upstream.URL + "/v1", "compat_name": "compaction-websocket", "provider_key": provider, "auth_kind": "apikey"},
+	})
+	if errRegister != nil {
+		t.Fatal(errRegister)
+	}
+	manager.RefreshSchedulerEntry(t.Name())
+	gin.SetMode(gin.TestMode)
+	handler := openaihandlers.NewOpenAIResponsesAPIHandler(handlers.NewBaseAPIHandlers(&cfg.SDKConfig, manager))
+	router := gin.New()
+	router.GET("/v1/responses", handler.ResponsesWebsocket)
+	server := httptest.NewServer(router)
+	defer server.Close()
+	conn, _, errDial := websocket.DefaultDialer.Dial("ws"+strings.TrimPrefix(server.URL, "http")+"/v1/responses", nil)
+	if errDial != nil {
+		t.Fatal(errDial)
+	}
+	defer func() { _ = conn.Close() }()
+	create := func(request string) gjson.Result {
+		t.Helper()
+		if errWrite := conn.WriteMessage(websocket.TextMessage, []byte(request)); errWrite != nil {
+			t.Fatal(errWrite)
+		}
+		_ = conn.SetReadDeadline(time.Now().Add(10 * time.Second))
+		for {
+			_, body, errRead := conn.ReadMessage()
+			if errRead != nil {
+				t.Fatal(errRead)
+			}
+			event := gjson.ParseBytes(body)
+			switch event.Get("type").String() {
+			case "error", "response.failed":
+				t.Fatalf("websocket request failed: %s", body)
+			case "response.completed":
+				return event.Get("response")
+			}
+		}
+	}
+
+	first := create(fmt.Sprintf(`{"type":"response.create","model":%q,"input":[{"role":"user","content":"OLD_TRANSCRIPT"}]}`, model))
+	<-requests
+	if first.Get("id").String() == "" {
+		t.Fatalf("missing response ID: %s", first.Raw)
+	}
+	compacted := create(fmt.Sprintf(`{"type":"response.create","previous_response_id":%q,"input":[{"type":"compaction_trigger"}]}`, first.Get("id").String()))
+	summaryRequest := <-requests
+	if !strings.Contains(summaryRequest, "OLD_TRANSCRIPT") || !strings.Contains(summaryRequest, "INITIAL_ASSISTANT") || gjson.Get(summaryRequest, "previous_response_id").Exists() {
+		t.Fatalf("incremental compaction lost resolved history: %s", summaryRequest)
+	}
+	if compacted.Get("output.0.type").String() != "compaction" || compacted.Get("output.0.encrypted_content").String() == "" {
+		t.Fatalf("invalid checkpoint: %s", compacted.Raw)
+	}
+	replayed := create(fmt.Sprintf(`{"type":"response.create","model":%q,"input":[%s,{"role":"user","content":"Continue with shell"}],"tools":[{"type":"function","name":"shell","parameters":{"type":"object"}}]}`, model, compacted.Get("output.0").Raw))
+	replayRequest := <-requests
+	if !strings.Contains(replayRequest, "CHECKPOINT_SUMMARY") || strings.Contains(replayRequest, "OLD_TRANSCRIPT") || strings.Contains(replayRequest, "encrypted_content") || !gjson.Get(replayRequest, "tools").Exists() {
+		t.Fatalf("checkpoint replay lost context or tools: %s", replayRequest)
+	}
+	if replayed.Get("output.0.type").String() != "function_call" || replayed.Get("output.0.name").String() != "shell" {
+		t.Fatalf("tool call lost after compaction: %s", replayed.Raw)
+	}
+}
